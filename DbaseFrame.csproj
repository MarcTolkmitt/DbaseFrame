<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 28.11.26: zweites Ziel netstandard2.0 = Kern ohne Oberfläche für ältere Umgebungen ( cTrader net6.0,
         GreenWave_Plugin ); Demoprogramm, WPF und Dateidialoge nur im net10-Build -->
    <TargetFrameworks>net10.0-windows7.0;netstandard2.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'netstandard2.0'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'netstandard2.0'">Library</OutputType>
    <UseWPF Condition="'$(TargetFramework)' != 'netstandard2.0'">true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>DbaseFrame</Title>
    <Authors>Marc Tolkmitt</Authors>
    <Description>Project to gain usage of Excel- and Access-data with C#. This project serves as example WPF-program and source for the utility classes.</Description>
    <PackageProjectUrl>https://github.com/MarcTolkmitt/DbaseFrame</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MarcTolkmitt/DbaseFrame</RepositoryUrl>
    <PackageTags>OleDB, Excel, Interop, C#</PackageTags>
    <PackageLicenseFile>Apache.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Copyright>Apache</Copyright>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- Paketnummer: die einzige Stelle ( 27.11.26 ). AssemblyVersion und FileVersion folgen ihr automatisch,
         im Code liefert sie PackageInfo.Version. Gepflegt wie die Klassennummern: bei Änderungen erhöhen,
         höchstens einmal am Tag ( Paketnummer ab 1.0.7; eine schon veröffentlichte Nummer
         braucht für Änderungen eine neue, auch am selben Tag ). -->
    <Version>1.0.9</Version>
    <AssemblyTitle>DbaseFrame</AssemblyTitle>
    <!-- 28.11.26: XML-Doku eingeschaltet ( IntelliSense im Paket ), alle Warnungen behoben -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <COMReference Include="Microsoft.Office.Interop.Excel">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>9</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>00020813-0000-0000-c000-000000000046</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 27.11.26: Microsoft.Data.SqlClient und System.Data.Odbc entfernt ( im Code unbenutzt; 6 statt 19 DLLs ) -->
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
  </ItemGroup>

  <!-- 28.11.26: im netstandard2.0-Build nur die Bibliothek; dynamic ( COM, ADOX ) braucht dort Microsoft.CSharp -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="App.xaml.cs;MainWindow.xaml.cs;DialogTablesChoice.xaml.cs;AssemblyInfo.cs;Message.cs" />
    <Page Remove="**\*.xaml" />
    <ApplicationDefinition Remove="App.xaml" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <!-- 28.11.26: ausdrücklich aufgenommen statt Update; mit zwei Zielen fand der Packlauf sie sonst nicht ( NU5030 ) -->
  <ItemGroup>
    <None Remove="Apache.txt;README.md" />
    <None Include="Apache.txt;README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
